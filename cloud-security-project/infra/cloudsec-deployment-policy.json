{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EventBridgeDeployment",
            "Effect": "Allow",
            "Action": [
                "events:PutRule",
                "events:PutTargets",
                "events:RemoveTargets",
                "events:DeleteRule"
            ],
            "Resource": "arn:aws:events:ap-south-1:774075583705:rule/cloudsec-*"
        },
        {
            "Sid": "SQSDeployment",
            "Effect": "Allow",
            "Action": [
                "sqs:CreateQueue",
                "sqs:SetQueueAttributes",
                "sqs:DeleteQueue"
            ],
            "Resource": "arn:aws:sqs:ap-south-1:774075583705:cloudsec-*"
        },
        {
            "Sid": "CloudTrailDeployment",
            "Effect": "Allow",
            "Action": [
                "cloudtrail:CreateTrail",
                "cloudtrail:StartLogging",
                "cloudtrail:UpdateTrail",
                "cloudtrail:DeleteTrail"
            ],
            "Resource": "arn:aws:cloudtrail:ap-south-1:774075583705:trail/cloudsec-*"
        },
        {
            "Sid": "S3BucketCreationForCloudTrail",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:PutBucketPolicy",
                "s3:GetBucketPolicy"
            ],
            "Resource": "arn:aws:s3:::cloudsec-*"
        }
    ]
}
